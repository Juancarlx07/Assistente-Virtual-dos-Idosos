# Supabase — copie para .env.local e preencha com os valores do seu projeto.
# (Nunca commite o .env.local com valores reais.)

# Públicos (expostos no navegador):
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL base da aplicação (para montar o link do portal de consentimento).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Observação: o portal self-service NÃO usa service role. Ele chama funções
# RPC (SECURITY DEFINER) definidas em supabase/migrations, com a anon key.
